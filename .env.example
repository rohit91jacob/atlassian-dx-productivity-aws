# Copy to .env and adjust. Every setting has a safe default (src/dx_productivity/config.py).
# Read by the Makefile. Keep comments on their own lines. Never commit .env.

# ---------------------------------------------------------------- storage / emulation
# local = filesystem stand-in for S3 + SQLite stand-in for DynamoDB (default)
# aws   = boto3 (real AWS, or LocalStack/moto through AWS_ENDPOINT_URL)
DX_BACKEND=local
DX_DATA_DIR=./data
# DX_RAW_BUCKET=dx-raw
# DX_STATE_TABLE=dx-state
# AWS_REGION=eu-west-1
# AWS_ENDPOINT_URL=http://localhost:4566
# sql = pyiceberg SQLite catalog (default), glue = AWS Glue Data Catalog
DX_ICEBERG_CATALOG=sql
# DX_ICEBERG_WAREHOUSE=s3://dx-curated/warehouse

# ---------------------------------------------------------------- sources
# live = real APIs, fixtures = recorded API data in tests/fixtures/api (offline)
DX_SOURCE=live
DX_JIRA_PROJECTS=KAFKA,SPARK,FLINK
DX_GITHUB_REPOS=apache/kafka:trunk:KAFKA,apache/spark:master:SPARK,apache/flink:master:FLINK
# History window of the first run; later runs continue from the watermarks.
DX_JIRA_LOOKBACK_DAYS=60
DX_GITHUB_LOOKBACK_DAYS=3
DX_OVERLAP_MINUTES=60
# Unauthenticated GitHub allows 60 requests/hour per IP; keep the budget under that without a token.
DX_GITHUB_MAX_REQUESTS=50
# Optional read-only token (public repositories only). Raises the limit to 5,000 requests/hour.
# Export GITHUB_TOKEN in your shell (or add a GITHUB_TOKEN line to .env); never commit it.
DX_JIRA_MIN_INTERVAL_SECONDS=1.0

# ---------------------------------------------------------------- privacy / quality / logs
# Pseudonymisation salt for people. The default is public; set a private value for real use.
# DX_PSEUDONYM_SALT=
DX_DQ_FAIL_ON_ERROR=true
DX_LOG_LEVEL=INFO
# json | text
DX_LOG_FORMAT=text
